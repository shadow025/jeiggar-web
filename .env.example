# Copia este archivo a .env y ajusta los valores
PORT=8000
# Token para entrar al panel /admin y a la API /api/admin/*  (usa una cadena larga y aleatoria)
ADMIN_TOKEN=cambia-este-token-por-uno-seguro
# Ruta del archivo SQLite (opcional)
# DB_PATH=./data/jeiggar.db
# Pon 1 si el servidor está detrás de un proxy (nginx, Render, Railway…)
TRUST_PROXY=0
