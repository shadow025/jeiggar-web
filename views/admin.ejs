<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="seccion">
  <div class="container admin" id="admin" data-admin>
    <div class="admin__barra">
      <div>
        <span class="eyebrow">Panel interno</span>
        <h1 class="h2" style="margin-top:10px">Solicitudes y cotizaciones</h1>
      </div>
      <div class="admin__filtros" data-admin-filtros hidden>
        <input type="search" data-filtro="q" placeholder="Buscar nombre, correo, documento…" aria-label="Buscar">
        <select data-filtro="tipo" aria-label="Tipo">
          <option value="">Todos los tipos</option>
          <option value="cotizacion">Cotizaciones</option>
          <option value="alquiler">Alquiler</option>
          <option value="contacto">Contacto</option>
        </select>
        <select data-filtro="estado" aria-label="Estado">
          <option value="">Todos los estados</option>
          <option value="nuevo">Nuevos</option>
          <option value="en_proceso">En proceso</option>
          <option value="atendido">Atendidos</option>
          <option value="descartado">Descartados</option>
        </select>
        <a class="btn btn--secundario btn--sm" data-exportar href="#">Exportar CSV <%- icono('flecha_abajo', { size: 16 }) %></a>
        <button class="btn btn--texto btn--sm" type="button" data-salir>Salir</button>
      </div>
    </div>

    <form class="panel admin-login" data-admin-login>
      <span class="eyebrow">Acceso</span>
      <h2 class="h3">Ingresa el token de administración</h2>
      <p class="small">Es el valor de <code>ADMIN_TOKEN</code> en el archivo <code>.env</code> del servidor.</p>
      <div class="campo"><label for="admin-token">Token</label><input id="admin-token" type="password" autocomplete="current-password" required></div>
      <div class="aviso aviso--error" data-aviso role="alert"></div>
      <button class="btn btn--primario" type="submit">Entrar <%- icono('flecha', { size: 18 }) %></button>
    </form>

    <div data-admin-contenido hidden style="display:grid;gap:24px">
      <div class="kpis" data-kpis></div>
      <div class="tabla-wrap">
        <table class="tabla">
          <thead>
            <tr><th>#</th><th>Fecha</th><th>Tipo</th><th>Nombre</th><th>Documento</th><th>Contacto</th><th>Servicio / equipo</th><th>Mensaje</th><th>Estado</th><th></th></tr>
          </thead>
          <tbody data-tabla></tbody>
        </table>
      </div>
      <p class="small texto-centro" data-vacio hidden>No hay solicitudes con esos filtros.</p>
    </div>
  </div>
</section>

<%- include('partials/footer', { scripts: '<script src="/js/admin.js?v=' + v + '" defer></script>' }) %>
