<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="container pagina-404">
  <div>
    <p class="display-xl" aria-hidden="true"><%= typeof error !== 'undefined' && error ? '500' : '404' %></p>
    <h1 class="h2"><%= typeof error !== 'undefined' && error ? 'Algo salió mal' : 'Página no encontrada' %></h1>
    <p class="lead mt-16">La página que buscas no existe o fue movida. Puedes volver al inicio o explorar nuestros servicios.</p>
    <div class="hero__acciones mt-24" style="justify-content:center">
      <a class="btn btn--primario" href="/">Ir al inicio <%- icono('flecha', { size: 18 }) %></a>
      <a class="btn btn--secundario" href="/servicios">Ver servicios</a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
