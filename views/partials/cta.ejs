<section class="cta" aria-label="Llamado a la acción">
  <div class="container">
    <div class="cta__caja">
      <div class="cta__escena" aria-hidden="true"><img src="/img/escena-grua-cta.svg" alt="" width="760" height="475" loading="lazy"></div>
      <div class="cta__texto">
        <h2 class="h2"><%= cta.titulo %></h2>
        <p><%= cta.texto %></p>
      </div>
      <div class="cta__acciones">
        <a class="btn btn--primario" href="/cotizar<%= typeof ctaServicio !== 'undefined' && ctaServicio ? '?servicio=' + ctaServicio : '' %>">¡Contáctanos! <%- icono('flecha', { size: 18 }) %></a>
        <a class="btn btn--oscuro" href="<%= empresa.whatsappHref %>" target="_blank" rel="noopener">WhatsApp <%- icono('whatsapp', { size: 18 }) %></a>
      </div>
    </div>
  </div>
</section>
