<%
  const esActivo = (href) => href === '/servicios' ? ruta.startsWith('/servicios') : ruta === href;
%>
<header class="encabezado" id="encabezado">
  <div class="container encabezado__inner">
    <a class="logo" href="/" aria-label="<%= empresa.nombreLargo %> - Inicio">
      <span class="logo__simbolo" aria-hidden="true">J</span>
      <span class="logo__nombre"><strong>JEIGGAR</strong><small>INGENIERÍA Y CONSTRUCCIÓN</small></span>
    </a>

    <nav class="nav" aria-label="Principal">
      <% site.navegacion.forEach((item) => { %>
        <% if (item.desplegable) { %>
          <button class="nav__item <%= esActivo(item.href) ? 'is-active' : '' %>" id="btn-servicios" aria-expanded="false" aria-controls="menu-servicios" aria-haspopup="true">
            <%= item.etiqueta %> <%- icono('chevron_abajo', { size: 14 }) %>
          </button>
        <% } else { %>
          <a class="nav__item <%= esActivo(item.href) ? 'is-active' : '' %>" href="<%= item.href %>" <%= esActivo(item.href) ? 'aria-current="page"' : '' %>><%= item.etiqueta %></a>
        <% } %>
      <% }) %>
    </nav>

    <div class="encabezado__acciones">
      <button class="btn-circulo" id="btn-tema" type="button" aria-label="Cambiar a modo oscuro" title="Modo oscuro / claro">
        <%- icono('luna', { size: 18 }) %>
      </button>
      <a class="btn btn--primario btn--sm" href="/cotizar">¡Contáctanos!</a>
      <button class="btn-circulo btn-menu" id="btn-menu" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
        <%- icono('menu', { size: 18 }) %>
      </button>
    </div>
  </div>

  <!-- Menú de servicios (escritorio) -->
  <div class="menu-servicios" id="menu-servicios" role="region" aria-label="Servicios">
    <div class="menu-servicios__lista">
      <% site.servicios.forEach((s) => { %>
        <a class="menu-servicios__item" href="/servicios/<%= s.slug %>">
          <span class="icono-caja"><%- icono(s.icono, { size: 20 }) %></span>
          <span><strong><%= s.nombreMenu || s.nombre %></strong><span><%= s.lema %></span></span>
        </a>
      <% }) %>
    </div>
    <div class="menu-servicios__destacado">
      <h3 class="h3">¿Listo para empezar tu próximo proyecto?</h3>
      <p>Contáctanos y descubre cómo podemos ayudarte.</p>
      <a class="btn btn--primario btn--sm" href="/cotizar">¡Contáctanos! <%- icono('flecha', { size: 18 }) %></a>
    </div>
  </div>
</header>

<!-- Menú móvil -->
<div class="menu-movil" id="menu-movil" aria-hidden="true">
  <div class="menu-movil__barra">
    <a class="logo" href="/">
      <span class="logo__simbolo" aria-hidden="true">J</span>
      <span class="logo__nombre"><strong>JEIGGAR</strong><small>INGENIERÍA Y CONSTRUCCIÓN</small></span>
    </a>
    <button class="btn-circulo" id="btn-cerrar-menu" type="button" aria-label="Cerrar menú"><%- icono('cerrar', { size: 18 }) %></button>
  </div>
  <nav class="menu-movil__lista" aria-label="Principal móvil">
    <a class="menu-movil__enlace <%= ruta === '/' ? 'is-active' : '' %>" href="/">Inicio</a>
    <% site.navegacion.forEach((item) => { %>
      <% if (item.desplegable) { %>
        <details class="menu-movil__grupo" <%= esActivo(item.href) ? 'open' : '' %>>
          <summary class="menu-movil__enlace <%= esActivo(item.href) ? 'is-active' : '' %>"><%= item.etiqueta %> <%- icono('chevron_abajo', { size: 16 }) %></summary>
          <div class="menu-movil__sub">
            <% site.servicios.forEach((s) => { %>
              <a href="/servicios/<%= s.slug %>"><span class="icono-caja icono-caja--sm"><%- icono(s.icono, { size: 18 }) %></span><span><%= s.nombreMenu || s.nombre %><span><%= s.lema %></span></span></a>
            <% }) %>
          </div>
        </details>
      <% } else { %>
        <a class="menu-movil__enlace <%= esActivo(item.href) ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.etiqueta %> <%- icono('chevron_der', { size: 16 }) %></a>
      <% } %>
    <% }) %>
  </nav>
  <div class="menu-movil__acciones">
    <a class="btn btn--primario btn--bloque" href="/cotizar">¡Contáctanos! <%- icono('flecha', { size: 18 }) %></a>
    <a class="btn btn--whatsapp btn--bloque" href="<%= empresa.whatsappHref %>" target="_blank" rel="noopener">WhatsApp <%- icono('whatsapp', { size: 18 }) %></a>
  </div>
</div>

<main id="contenido">
